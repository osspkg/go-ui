{
  "name": "@osspkg/ui-workspace",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "eslint \"react-sdk/**/*.{ts,tsx}\" \"example/react/**/*.{ts,tsx}\"",
    "format": "prettier --write \"react-sdk/**/*.{ts,tsx,css}\" \"example/react/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"react-sdk/**/*.{ts,tsx,css}\" \"example/react/**/*.{ts,tsx,css,html}\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^8.57.1",
    "@types/node": "^24.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.0"
  },
  "type": "module"
}
